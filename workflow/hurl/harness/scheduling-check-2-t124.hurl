# Replay of the harness's scheduling/check-2 transcript from tick 124 (generated by
# workflow/bin/transcripts.py; regenerate rather than edit). Steps before the last kept the status the
# harness accepted; the last is the request it rejected, so it must not answer that again.

DELETE {{base_url}}/programme/R3/S2
HTTP *
[Asserts]
status < 500

POST {{base_url}}/speakers
{"name": "Frances Knuth 9250", "email": "{{run}}-x-71b7ebc523d4@example.test"}
HTTP 201
[Captures]
id1: jsonpath "$.id"

POST {{base_url}}/talks
{"title": "rmg kdzzgqs hm hptr qnm uyef t o kmid", "format": "PRESENTATION", "level": "INTERMEDIATE", "speakerId": {{id1}}}
HTTP 201
[Captures]
id2: jsonpath "$.id"

PUT {{base_url}}/talks/{{id2}}/ratings/330101
{"score": 1}
HTTP 200

PUT {{base_url}}/talks/{{id2}}/ratings/330102
{"score": 4}
HTTP 200

PUT {{base_url}}/talks/{{id2}}/status
{"status": "ACCEPTED"}
HTTP 200

POST {{base_url}}/talks/{{id2}}/withdraw
{"speakerId": {{id1}}}
HTTP 200

PUT {{base_url}}/programme/R3/S2
{"talkId": {{id2}}}
HTTP 409

GET {{base_url}}/programme/R3/S2
HTTP *
[Asserts]
status != 200
