# Speakers: bio is at most 500 characters. Characters, not UTF-16 units or bytes:
# 500 emoji fit (gap G2 in workflow/gap-analysis-base.md), 501 of anything doesn't.

POST {{base_url}}/speakers
{ "name": "Bio 500", "email": "bio500-{{newUuid}}@example.com", "bio": "" }
HTTP 201
[Asserts]
jsonpath "$.bio" == ""

POST {{base_url}}/speakers
{ "name": "Bio 501", "email": "bio501-{{newUuid}}@example.com", "bio": "" }
